# Required production variables. Configure values in Coolify; never commit secrets.
DATABASE_URL=
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_APPLICATION_NAME=fastsocial
APP_SECRET=
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
XAI_API_KEY=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional direct and managed social connectors.
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
ARCADE_API_KEY=
ARCADE_MCP_URL=
COMPOSIO_API_KEY=
COMPOSIO_MCP_URL=

# Runtime contract.
APP_ENV=production
SERVICE_URL=https://fastsocial.org
PORT=5062
AUTO_CREATE_SCHEMA=0
SCHEDULER_ENABLED=1
DEFAULT_TIMEZONE=Europe/Tallinn
MEDIA_STORAGE=r2
R2_REGION=auto
R2_BUCKET=fastsocial-media
R2_KEY_PREFIX=fastsocial
GOOGLE_REDIRECT_URI=https://fastsocial.org/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4-1-fast-reasoning
LINKEDIN_API_VERSION=202606
