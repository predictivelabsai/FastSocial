# Required production variables. Configure values in Coolify; never commit secrets.
DATABASE_URL=
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_APPLICATION_NAME=fastsocial
APP_SECRET=
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
XAI_API_KEY=
OPENAI_API_KEY=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional direct and managed social connectors.
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
ARCADE_API_KEY=
ARCADE_MCP_URL=
COMPOSIO_API_KEY=
COMPOSIO_MCP_URL=

# Runtime contract.
APP_ENV=production
SERVICE_URL=https://fastsocial.org
PORT=5062
AUTO_CREATE_SCHEMA=0
SCHEDULER_ENABLED=1
DEFAULT_TIMEZONE=Europe/Tallinn
MEDIA_STORAGE=r2
R2_REGION=auto
R2_BUCKET=fastsocial-media
R2_KEY_PREFIX=fastsocial
GOOGLE_REDIRECT_URI=https://fastsocial.org/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_PROVIDER=xai
MODEL_NAME=grok-4.5
IMAGE_MODEL=grok-imagine-image-quality
VIDEO_MODEL=grok-imagine-video-1.5
OPENAI_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_VIDEO_MODEL=sora-2-pro
MODEL_SERVER_ALLOWED_EMAILS=kaljuvee@gmail.com
MODEL_REQUEST_TIMEOUT=300
LINKEDIN_API_VERSION=202606
POSTMARK_SERVER_TOKEN=
REPORT_FROM_EMAIL=reports@fastsocial.org
