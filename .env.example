# Application
APP_ENV=development
APP_SECRET=replace-with-a-long-random-value
TOKEN_ENCRYPTION_KEY=
SERVICE_URL=http://localhost:5062
PORT=5062
AUTO_CREATE_SCHEMA=1
SCHEDULER_ENABLED=1
DEFAULT_TIMEZONE=Europe/Tallinn

# PostgreSQL
DATABASE_URL=postgresql+psycopg://fastsocial:fastsocial@localhost:5438/fastsocial
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_APPLICATION_NAME=fastsocial

# Local development bootstrap (optional)
DEV_USER_EMAIL=admin@fastsocial.local
DEV_USER_PASSWORD=

# Google application login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5062/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# Cloudflare R2. Use a dedicated fastsocial-media bucket.
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=./data/media
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fastsocial-media
R2_KEY_PREFIX=fastsocial

# AI model defaults. Workspace BYOK settings override these values.
MODEL_PROVIDER=xai
MODEL_NAME=grok-4.5
MODEL_SERVER_ALLOWED_EMAILS=kaljuvee@gmail.com
MODEL_REQUEST_TIMEOUT=300

# xAI
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5
IMAGE_MODEL=grok-imagine-image-quality
VIDEO_MODEL=grok-imagine-video-1.5

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_VIDEO_MODEL=sora-2-pro

# Direct social OAuth applications
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202606
BLUESKY_APP_PASSWORD_ENABLED=1

# Managed integration alternatives
ARCADE_API_KEY=
ARCADE_MCP_URL=
COMPOSIO_API_KEY=
COMPOSIO_MCP_URL=

# Automated report email delivery (R2 report generation works without these)
POSTMARK_SERVER_TOKEN=
REPORT_FROM_EMAIL=reports@fastsocial.org
